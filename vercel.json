{
  "rewrites": [
    {
      "source": "/app-motion.css",
      "destination": "/app-motion.css"
    },
    {
      "source": "/app-motion.js",
      "destination": "/app-motion.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/manifest.json",
      "destination": "/manifest.json"
    },
    {
      "source": "/icon-:size.png",
      "destination": "/icon-:size.png"
    },
    {
      "source": "/icon.svg",
      "destination": "/icon.svg"
    },
    {
      "source": "/badge-icon.svg",
      "destination": "/badge-icon.svg"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/push-send-deadlines",
      "schedule": "0 22 * * *"
    }
  ]
}
